# 建置產物
build/
.gradle/
*.class

# Wynntils 的 jar —— 是別人的作品，不隨本專案散布。
# 請自行從 https://modrinth.com/mod/wynntils/versions 下載 fabric 版放進 libs/
libs/*.jar

# 從官方 CDN 下載的原始資料，可用 tools/fetch.py 重新取得
tools/raw/
# fetch.py 與 fetch-discoveries.py 的暫存區。抓來的原始資料不進版控——
# 隨時可以重抓，而且 wiki 的內容有它自己的授權。
raw/

# 個人遊玩記錄，可能夾帶玩家名稱，不要進版控
captured.json
tooltip-debug-*.json

# tools/typing-audit.py 的報告，每次跑都會重產
typing-out.txt

# IDE
.idea/
*.iml
.vscode/
logs/
__pycache__/

# 一次性的批次腳本，不進版控
workspace/scratch/
