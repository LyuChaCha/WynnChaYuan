   "source": "wiki"
  },
  "Point of No Return#019": {
   "src": "You... could it be...? Are you... real?",
   "dst": "",
   "role": "desc",
   "kind": "dialogue",
   "quest": "Point of No Return",
   "stage": "Stage 1",
   "speaker": "Lutho Citizen",
   "source": "wiki"
  },
  "Point of No Return#020": {
   "src": "Ha... ha... you should not have come here.",
   "dst": "",
   "role": "desc",
   "kind": "dialogue",
   "quest": "Point of No Return",
   "stage": "Stage 1",
   "speaker": "Lutho Citizen",
   "source": "wiki"
  },
  "Point of No Return#021": {
   "src": "Have you seen the others? Barely clinging on to life... hollowed, empty.",
   "dst": "",
   "role": "desc",
   "kind": "dialogue",
   "quest": "Point of No Return",
   "stage": "Stage 1",
   "speaker": "Lutho Citizen",
   "source": "wiki"
  },
  "Point of No Return#022": {
   "src": "Only I persist. And, now... you, too, have been ensnared.",
   "dst": "",
   "role": "desc",
   "kind": "dialogue",
   "quest": "Point of No Return",
   "stage": "Stage 1",
   "speaker": "Lutho Citizen",
   "source": "wiki"
  },
  "Point of No Return#023": {
   "src": "Fight against your fate, if you so choose... it makes no difference in the end. Ha... ha... ha...",
   "dst": "",
   "role": "desc",
   "kind": "dialogue",
   "quest": "Point of No Return",
